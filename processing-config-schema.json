{
  "type": "object",
  "layout": "tabs",
  "allOf": [
    {
      "title": "Source",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "title": "URL d'accès à l'archive GTFS",
          "description": "Les protocoles supportés sont HTTP, HTTPS, FTP, FTPS et SFTP. Le FTPS implicite utilise le port 990, sinon le FTPS explicite s'applique. Seul le mode passif est supporté pour FTP/FTPS."
        },
        "username": {
          "type": "string",
          "title": "Utilisateur",
          "description": "Laissez vide pour un accès FTP anonyme.",
          "layout": {
            "props": {
              "autocomplete": "suppress",
              "name": "gtfs-source-user"
            }
          }
        },
        "password": {
          "type": "string",
          "title": "Mot de passe",
          "layout": {
            "props": {
              "type": "password",
              "autocomplete": "one-time-code"
            }
          }
        },
        "sshKey": {
          "type": "string",
          "title": "Clé privée SSH",
          "description": "Alternative au mot de passe pour une source SFTP.",
          "layout": {
            "if": "parent.data.url && parent.data.url.startsWith('sftp:')",
            "props": {
              "type": "password",
              "autocomplete": "one-time-code"
            }
          }
        }
      }
    },
    {
      "title": "Traitement",
      "properties": {
        "mode": {
          "type": "string",
          "title": "Mode du traitement",
          "description": "« Valider uniquement » contrôle l'archive et écrit le résumé dans le journal, sans produire de jeu de données. « Importer » conserve le comportement habituel.",
          "default": "import",
          "oneOf": [
            {
              "const": "import",
              "title": "Importer les données dans des jeux de données"
            },
            {
              "const": "validate",
              "title": "Valider uniquement l'archive"
            }
          ]
        },
        "validationEnabled": {
          "type": "boolean",
          "title": "Valider l'archive avant l'import",
          "description": "Le résumé de la validation est écrit dans le journal du traitement, l'import se poursuit.",
          "default": true,
          "layout": {
            "if": "rootData.mode !== 'validate'"
          }
        },
        "failOnError": {
          "type": "boolean",
          "title": "Échouer si l'archive contient des anomalies",
          "description": "Interrompt le traitement en cas d'anomalies fatales ou d'erreurs. Sinon le résumé est seulement écrit dans le journal.",
          "default": false,
          "layout": {
            "if": "rootData.mode !== 'validate' && rootData.validationEnabled !== false"
          }
        },
        "validatorUrl": {
          "type": "string",
          "title": "URL du service de validation",
          "description": "Service compatible [transport-validator](https://github.com/etalab/transport-validator). Par défaut l'instance publique de transport.data.gouv.fr : l'archive lui est envoyée sans authentification, endpoint non documenté et sans SLA.",
          "default": "https://validation.transport.data.gouv.fr/validate",
          "layout": {
            "if": "rootData.mode === 'validate' || rootData.validationEnabled !== false"
          }
        },
        "maxIssues": {
          "type": "number",
          "title": "Anomalies détaillées maximum par type",
          "description": "Nombre d'anomalies renvoyées en détail par type. Les compteurs, eux, restent exhaustifs.",
          "default": 1000,
          "layout": {
            "if": "rootData.mode === 'validate' || rootData.validationEnabled !== false"
          }
        }
      }
    },
    {
      "title": "Jeux de données",
      "layout": {
        "if": "rootData.mode !== 'validate'"
      },
      "properties": {
        "datasetMode": {
          "type": "string",
          "default": "create",
          "layout": "none"
        },
        "dataset": {
          "deprecated": true,
          "type": [
            "object",
            "null"
          ],
          "description": "DEPRECATED — compatibilité v0.3.10, à retirer à la prochaine majeure. Jeu de métadonnées unique de la version publiée, repris au premier lancement par migrateLegacyConfig puis laissé à null. Déclaré uniquement pour que le formulaire ne le supprime pas (removeAdditional) avant que la reprise ait eu lieu.",
          "layout": "none",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "not": {
                  "const": "validate"
                }
              }
            }
          },
          "then": {
            "discriminator": {
              "propertyName": "datasetMode"
            },
            "oneOfLayout": {
              "label": "Action"
            },
            "oneOf": [
              {
                "title": "Créer les jeux de données",
                "required": [
                  "datasetMode"
                ],
                "properties": {
                  "datasetMode": {
                    "type": "string",
                    "const": "create"
                  },
                  "datasetTitle": {
                    "type": "string",
                    "title": "Titre de base des jeux de données",
                    "default": "GTFS",
                    "description": "Chaque jeu créé porte ce titre suivi de son rôle, par exemple « GTFS - arrêts ». Les jeux ne sont créés qu'une fois : la configuration bascule ensuite en mise à jour."
                  },
                  "resources": {
                    "type": "array",
                    "title": "Jeux de données à produire",
                    "description": "Seules les données sélectionnées sont lues dans l'archive GTFS.",
                    "default": [
                      "metadata",
                      "stops",
                      "stop-times",
                      "shapes"
                    ],
                    "uniqueItems": true,
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "metadata",
                          "title": "Métadonnées"
                        },
                        {
                          "const": "stops",
                          "title": "Arrêts"
                        },
                        {
                          "const": "stop-times",
                          "title": "Horaires"
                        },
                        {
                          "const": "shapes",
                          "title": "Tracés"
                        }
                      ]
                    }
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "datasetTitle"
                    ]
                  },
                  {
                    "deprecated": true,
                    "description": "DEPRECATED — compatibilité v0.3.10, à retirer à la prochaine majeure. Reprise du titre imbriqué dans `dataset`, le temps que le premier lancement convertisse la configuration.",
                    "required": [
                      "dataset"
                    ],
                    "properties": {
                      "dataset": {
                        "type": "object",
                        "required": [
                          "title"
                        ]
                      }
                    }
                  }
                ],
                "errorMessage": {
                  "anyOf": "Donnez un titre de base aux jeux de données à créer."
                }
              },
              {
                "title": "Mettre à jour les jeux de données",
                "required": [
                  "datasetMode"
                ],
                "properties": {
                  "datasetMode": {
                    "type": "string",
                    "const": "update"
                  },
                  "datasets": {
                    "type": "array",
                    "title": "Jeux de données à mettre à jour",
                    "description": "Une ligne par donnée produite. Laisser une ligne sans jeu de données cesse de produire la donnée correspondante.",
                    "default": [
                      {
                        "resource": "metadata"
                      },
                      {
                        "resource": "stops"
                      },
                      {
                        "resource": "stop-times"
                      },
                      {
                        "resource": "shapes"
                      }
                    ],
                    "layout": {
                      "listEditMode": "inline",
                      "listActions": []
                    },
                    "items": {
                      "type": "object",
                      "required": [
                        "resource"
                      ],
                      "layout": [
                        {
                          "children": [
                            "resource"
                          ],
                          "cols": 4
                        },
                        {
                          "children": [
                            "dataset"
                          ],
                          "cols": 8
                        }
                      ],
                      "properties": {
                        "resource": {
                          "type": "string",
                          "title": "Donnée",
                          "oneOf": [
                            {
                              "const": "metadata",
                              "title": "Métadonnées"
                            },
                            {
                              "const": "stops",
                              "title": "Arrêts"
                            },
                            {
                              "const": "stop-times",
                              "title": "Horaires"
                            },
                            {
                              "const": "shapes",
                              "title": "Tracés"
                            }
                          ],
                          "layout": {
                            "props": {
                              "readonly": true
                            }
                          }
                        },
                        "dataset": {
                          "type": "object",
                          "title": "Jeu de données existant",
                          "required": [
                            "id"
                          ],
                          "layout": {
                            "getItems": {
                              "url": "${context.dataFairUrl}/api/v1/datasets?select=id,title&size=50&${context.ownerFilter}&raw=true",
                              "qSearchParam": "q",
                              "itemsResults": "data.results",
                              "itemTitle": "item.title",
                              "itemKey": "item.id"
                            }
                          },
                          "properties": {
                            "id": {
                              "type": "string",
                              "title": "Identifiant"
                            },
                            "title": {
                              "type": "string",
                              "title": "Titre"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "datasets"
                    ]
                  },
                  {
                    "deprecated": true,
                    "description": "DEPRECATED — compatibilité v0.3.10, à retirer à la prochaine majeure. Reprise du jeu de métadonnées unique `dataset`, le temps que le premier lancement convertisse la configuration.",
                    "required": [
                      "dataset"
                    ],
                    "properties": {
                      "dataset": {
                        "type": "object",
                        "required": [
                          "id"
                        ]
                      }
                    }
                  }
                ],
                "errorMessage": {
                  "anyOf": "Renseignez au moins un jeu de données à mettre à jour."
                }
              }
            ]
          },
          "errorMessage": {
            "if": "Complétez la configuration des jeux de données."
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "mode": {
                    "not": {
                      "const": "validate"
                    }
                  }
                }
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "resources"
                    ],
                    "properties": {
                      "resources": {
                        "contains": {
                          "const": "metadata"
                        }
                      }
                    }
                  },
                  {
                    "required": [
                      "datasets"
                    ],
                    "properties": {
                      "datasets": {
                        "contains": {
                          "required": [
                            "resource",
                            "dataset"
                          ],
                          "properties": {
                            "resource": {
                              "const": "metadata"
                            },
                            "dataset": {
                              "required": [
                                "id"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "downloadZip": {
                "type": "boolean",
                "title": "Publier les fichiers sources comme fichier zip sur le jeu de métadonnées",
                "description": "Sinon les fichiers sources seront publiés directement dézippés.",
                "default": false
              },
              "realtimeUrl": {
                "type": "string",
                "title": "URL du flux GTFS-RT (VehiclePositions)",
                "description": "Optionnel. Le flux est déclaré comme pièce jointe distante du jeu de métadonnées : les applications le téléchargent via le serveur data-fair, sans contrainte de CORS.",
                "format": "uri"
              }
            }
          }
        }
      ]
    }
  ]
}
