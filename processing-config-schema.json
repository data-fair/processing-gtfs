{
  "type": "object",
  "layout": "tabs",
  "required": ["datasetMode", "url"],
  "allOf": [
    {
      "title": "Jeux de données",
      "default": {
        "datasetMode": "create"
      },
      "oneOf": [
        {
          "title": "Créer les jeux de données",
          "required": ["datasetTitle", "resources"],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "create",
              "title": "Action"
            },
            "datasetTitle": {
              "type": "string",
              "title": "Titre de base des jeux de données",
              "description": "Chaque jeu créé porte ce titre suivi de son rôle, par exemple « Réseau Kicéo - arrêts »."
            },
            "resources": {
              "type": "object",
              "title": "Jeux de données à produire",
              "description": "Seules les données cochées sont lues dans l'archive GTFS.",
              "properties": {
                "metadata": {
                  "type": "boolean",
                  "title": "Métadonnées",
                  "description": "Jeu sans données, porteur de l'archive ou des fichiers GTFS en pièces jointes.",
                  "default": true
                },
                "stops": {
                  "type": "boolean",
                  "title": "Arrêts",
                  "description": "Un point par arrêt, avec les lignes qui le desservent.",
                  "default": true
                },
                "stopTimes": {
                  "type": "boolean",
                  "title": "Horaires",
                  "description": "Un passage par arrêt et par course, avec la période de validité.",
                  "default": true
                },
                "shapes": {
                  "type": "boolean",
                  "title": "Tracés",
                  "description": "Un tracé par forme déclarée dans shapes.txt.",
                  "default": true
                }
              }
            }
          }
        },
        {
          "title": "Mettre à jour les jeux de données",
          "required": ["datasets"],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "update"
            },
            "datasets": {
              "type": "array",
              "title": "Jeux de données à mettre à jour",
              "description": "Un jeu par rôle. Retirer une ligne cesse de produire la donnée correspondante.",
              "layout": {
                "comp": "list",
                "listEditMode": "inline",
                "messages": {
                  "addItem": "Ajouter un jeu de données"
                }
              },
              "items": {
                "type": "object",
                "required": ["key", "id"],
                "properties": {
                  "key": {
                    "type": "string",
                    "title": "Rôle",
                    "oneOf": [
                      { "const": "metadata", "title": "Métadonnées" },
                      { "const": "stops", "title": "Arrêts" },
                      { "const": "stop-times", "title": "Horaires" },
                      { "const": "shapes", "title": "Tracés" }
                    ]
                  },
                  "id": {
                    "type": "string",
                    "title": "Identifiant"
                  },
                  "title": {
                    "type": "string",
                    "title": "Titre"
                  }
                },
                "layout": {
                  "getItems": {
                    "url": "${context.dataFairUrl}/api/v1/datasets?select=id,title&${context.ownerFilter}&raw=true",
                    "qSearchParam": "q",
                    "itemsResults": "data.results",
                    "itemTitle": "item.title",
                    "itemKey": "item.id"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "Paramètres",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "title": "URL d'accès à l'archive GTFS",
          "description": "Les protocoles supportés sont HTTP, HTTPS et SFTP."
        },
        "username": {
          "type": "string",
          "title": "Utilisateur",
          "layout": {
            "props": {
              "autocomplete": "suppress"
            }
          }
        },
        "password": {
          "type": "string",
          "title": "Mot de passe",
          "layout": {
            "props": {
              "type": "password",
              "autocomplete": "suppress"
            }
          }
        },
        "sshKey": {
          "type": "string",
          "title": "Clé privée SSH",
          "description": "Alternative au mot de passe pour une source SFTP.",
          "layout": {
            "props": {
              "type": "password",
              "autocomplete": "suppress"
            }
          }
        }
      },
      "if": {
        "anyOf": [
          {
            "required": ["resources"],
            "properties": {
              "resources": {
                "required": ["metadata"],
                "properties": {
                  "metadata": { "const": true }
                }
              }
            }
          },
          {
            "required": ["datasets"],
            "properties": {
              "datasets": {
                "contains": {
                  "required": ["key"],
                  "properties": {
                    "key": { "const": "metadata" }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "downloadZip": {
            "type": "boolean",
            "title": "Publier les fichiers sources comme fichier zip sur le jeu de métadonnées",
            "description": "Sinon les fichiers sources seront publiés directement dézippés.",
            "default": false
          }
        }
      }
    },
    {
      "title": "Concepts",
      "description": "À renseigner uniquement si votre organisation dispose d'un vocabulaire privé. Laissés vides, seuls les concepts du vocabulaire standard sont posés.",
      "properties": {
        "stopConcept": {
          "type": "string",
          "title": "Concept « arrêt »",
          "description": "Posé sur stop_id, dans les arrêts comme dans les horaires. C'est cette annotation croisée qui rend les deux jeux joignables."
        },
        "routeConcept": {
          "type": "string",
          "title": "Concept « ligne »",
          "description": "Posé sur les lignes desservant un arrêt et sur le nom court de la ligne d'un tracé."
        }
      }
    }
  ]
}
